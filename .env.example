# Vorlage fuer docker-compose.prod.yml (Produktions-/Deployment-Orchestrierung, siehe
# README.md "Produktions-Deployment"). Datei kopieren und echte Werte eintragen:
#
#   cp .env.example .env
#
# .env ist git-ignoriert (siehe .gitignore) - NIEMALS echte Secrets committen.

# --------------------------------------------------------------------------------------------
# PostgreSQL-Zugangsdaten (eine DB pro Service, Database-per-Service, ADR 0001). Je Service
# ein eigener Benutzer/Passwort empfohlen (kein geteiltes Superuser-Passwort ueber alle DBs).
# --------------------------------------------------------------------------------------------
CUSTOMER_DB_USER=customer_service
CUSTOMER_DB_PASSWORD=change-me-customer-db

EMPLOYEE_DB_USER=employee_service
EMPLOYEE_DB_PASSWORD=change-me-employee-db

APPOINTMENT_DB_USER=appointment_service
APPOINTMENT_DB_PASSWORD=change-me-appointment-db

CATALOG_DB_USER=catalog_service
CATALOG_DB_PASSWORD=change-me-catalog-db

# --------------------------------------------------------------------------------------------
# RabbitMQ (Wolverine Integration Events: customer-/employee-/appointment-service).
# --------------------------------------------------------------------------------------------
RABBITMQ_USER=crm
RABBITMQ_PASSWORD=change-me-rabbitmq

# --------------------------------------------------------------------------------------------
# Gemeinsames JWT-Schema (Issuer/Audience/SigningKey) fuer identity-service (Aussteller) und
# Gateway/alle Services (Validierer, Defense in Depth, ADR 0001). SigningKey: mindestens 32
# zufaellige Bytes, z.B. erzeugt via `openssl rand -base64 32`. Issuer/Audience muessen exakt
# mit den Werten aus AppHost/Crm.AppHost/AppHost.cs (jwt-issuer/jwt-audience) uebereinstimmen,
# falls Dev- und Prod-Tokens je austauschbar sein sollen (i.d.R. nicht erforderlich).
# --------------------------------------------------------------------------------------------
JWT_ISSUER=https://crm-identity
JWT_AUDIENCE=crm-api
JWT_SIGNING_KEY=change-me-at-least-32-random-bytes-base64

# --------------------------------------------------------------------------------------------
# identity-service: Seed-Nutzer (In-Memory, keine eigene DB, siehe README.md).
# --------------------------------------------------------------------------------------------
IDENTITY_ADMIN_PASSWORD=change-me-admin-password
IDENTITY_EMPLOYEE_PASSWORD=change-me-employee-password

# Login-Brute-Force-Limit (OWASP A04). Produktionsstandard ist 5/Minute (identity-service
# appsettings.json); nur fuer CI/E2E-Laeufe mit vielen aufeinanderfolgenden Logins erhoehen.
LOGIN_RATE_LIMIT_PERMIT_LIMIT=5

# --------------------------------------------------------------------------------------------
# CORS: oeffentlicher Origin, unter dem crm-web/nginx tatsaechlich erreichbar ist (Gateway
# erlaubt nur diesen Origin, OWASP A05). Bei einem vorgeschalteten TLS-Reverse-Proxy den
# externen https://-Origin eintragen, nicht localhost.
# --------------------------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost

# --------------------------------------------------------------------------------------------
# crm-web/nginx: oeffentlicher Port fuer das Frontend.
# --------------------------------------------------------------------------------------------
CRM_WEB_HTTP_PORT=80
# CRM_WEB_HTTPS_PORT=443
