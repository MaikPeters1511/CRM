{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "JwtBearer": {
      "Issuer": "https://crm-identity",
      "Audience": "crm-api",
      "SigningKey": ""
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200", "http://localhost:4201"]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-service-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "customers-route": {
        "ClusterId": "customer-service-cluster",
        "AuthorizationPolicy": "gateway-authenticated",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "employees-route": {
        "ClusterId": "employee-service-cluster",
        "AuthorizationPolicy": "gateway-authenticated",
        "Match": {
          "Path": "/api/employees/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-service"
          }
        }
      },
      "customer-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://customer-service"
          }
        }
      },
      "employee-service-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://employee-service"
          }
        }
      }
    }
  }
}
