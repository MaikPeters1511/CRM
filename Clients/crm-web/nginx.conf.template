# nginx-Konfigurationsvorlage fuer den crm-web Produktions-Container.
#
# Wird vom offiziellen nginx-Docker-Entrypoint beim Container-Start automatisch per `envsubst`
# verarbeitet (Dateien unter /etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf), da
# nginx selbst keine Docker-Compose-Service-Discovery/Umgebungsvariablen zur Laufzeit lesen kann.
# ${API_GATEWAY_UPSTREAM} kommt aus der ENV-Variable im Dockerfile/docker-compose.prod.yml
# (Standard: "gateway:8080" - Name des gateway-Containers im gemeinsamen Docker-Netzwerk).
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API-Traffic an das YARP-Gateway weiterleiten (einziger oeffentlicher Eintrittspunkt fuer
    # /api/**, siehe Gateway/Crm.Gateway/appsettings.json Routen-Konfiguration).
    location /api/ {
        proxy_pass http://${API_GATEWAY_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA-Fallback-Routing: alle unbekannten Pfade (Angular-Client-Routen) auf index.html
    # zurueckfallen lassen, statt nginx 404 auszuliefern.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Statische Assets mit Hash im Dateinamen langfristig cachen (Angular-Build-Output).
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }
}
