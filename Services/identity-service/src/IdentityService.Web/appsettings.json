{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "JwtBearer": {
      "Issuer": "https://crm-identity",
      "Audience": "crm-api",
      "SigningKey": "",
      "AccessTokenLifetimeMinutes": 60
    }
  },
  "IdentitySeed": {
    "AdminEmail": "admin@crm.local",
    "AdminPassword": "",
    "AdminDisplayName": "CRM Admin",
    "EmployeeEmail": "employee@crm.local",
    "EmployeePassword": "",
    "EmployeeDisplayName": "CRM Employee"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  }
}
